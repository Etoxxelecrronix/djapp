<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Engine DJ Playlist Builder"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="30dp"/>

    <Button
        android:id="@+id/btn_select_usb"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1. USB-Stick Root wählen"
        android:layout_marginBottom="15dp"/>

    <Button
        android:id="@+id/btn_select_folder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="2. Neuen Musik-Ordner wählen"
        android:layout_marginBottom="40dp"/>

    <Button
        android:id="@+id/btn_run_sync"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="3. Playlist automatisch erstellen"
        android:backgroundTint="#FF4500"
        android:textColor="#FFFFFF"
        android:textStyle="bold"/>

</LinearLayout>
